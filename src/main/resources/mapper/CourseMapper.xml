<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.grade.mapper.CourseMapper">

    <select id="selectAll" resultType="com.grade.entity.Course">
        SELECT * FROM course
    </select>

    <select id="selectById" resultType="com.grade.entity.Course">
        SELECT * FROM course WHERE id = #{id}
    </select>

    <insert id="insert" parameterType="com.grade.entity.Course" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO course (course_name, credit)
        VALUES (#{courseName}, #{credit})
    </insert>

    <update id="update" parameterType="com.grade.entity.Course">
        UPDATE course SET course_name = #{courseName}, credit = #{credit} WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM course WHERE id = #{id}
    </delete>
</mapper>
