<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.grade.mapper.StudentMapper">

    <select id="selectAll" resultType="com.grade.entity.Student">
        SELECT * FROM student
    </select>

    <select id="selectById" resultType="com.grade.entity.Student">
        SELECT * FROM student WHERE id = #{id}
    </select>

    <select id="selectByUserId" resultType="com.grade.entity.Student">
        SELECT * FROM student WHERE user_id = #{userId}
    </select>

    <select id="selectByClassId" resultType="com.grade.entity.Student">
        SELECT * FROM student WHERE class_id = #{classId}
    </select>

    <insert id="insert" parameterType="com.grade.entity.Student" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO student (user_id, student_no, name, class_id)
        VALUES (#{userId}, #{studentNo}, #{name}, #{classId})
    </insert>

    <update id="update" parameterType="com.grade.entity.Student">
        UPDATE student SET student_no = #{studentNo}, name = #{name}, class_id = #{classId} WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM student WHERE id = #{id}
    </delete>
</mapper>
