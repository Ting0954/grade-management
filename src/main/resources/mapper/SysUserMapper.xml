<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.grade.mapper.SysUserMapper">

    <select id="selectAll" resultType="com.grade.entity.SysUser">
        SELECT * FROM sys_user
    </select>

    <select id="selectById" resultType="com.grade.entity.SysUser">
        SELECT * FROM sys_user WHERE id = #{id}
    </select>

    <select id="selectByUsername" resultType="com.grade.entity.SysUser">
        SELECT * FROM sys_user WHERE username = #{username}
    </select>

    <insert id="insert" parameterType="com.grade.entity.SysUser" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sys_user (username, password, real_name, role, class_id)
        VALUES (#{username}, #{password}, #{realName}, #{role}, #{classId})
    </insert>

    <update id="update" parameterType="com.grade.entity.SysUser">
        UPDATE sys_user
        SET username = #{username}, password = #{password}, real_name = #{realName}, role = #{role}, class_id = #{classId}
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM sys_user WHERE id = #{id}
    </delete>
</mapper>
